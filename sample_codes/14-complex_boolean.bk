// 14-complex_boolean.bk
// Demonstrates complex/simple logical expressions using && and ||.

main() {
    x = 5
    y = 10
    z = 0

    // AND: both must be true
    if (x > 0 && y > 0) {
        print("both positive")
    }

    // AND: one false makes the whole expression false
    if (x > 0 && y > 100) {
        print("unreachable")
    } else {
        print("y is not > 100")
    }

    // OR: at least one must be true
    if (z == 0 || x == 5) {
        print("z is zero OR x is five")
    }

    // OR: both false
    if (z > 0 || x > 100) {
        print("unreachable")
    } else {
        print("neither condition met")
    }

    // NOT combined with AND
    if (!(x > 100) && y < 20) {
        print("x not > 100 AND y < 20")
    }

    // Boolean variable in logical expr
    a = true
    b = false
    print(a && b)     // false
    print(a || b)     // true
    print(!a || b)    // false

    // Expression result stored
    result = (x + y > 10) && (y - x > 0)
    print(result)     // true
}
