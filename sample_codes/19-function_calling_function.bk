// 19-function_calling_function.bk
// Demonstrates calling the same function multiple times with different arguments.

func square(n) {
    return n * n
}

func greet(name) {
    print("Hi, " + name + "!")
}

func clamp(v, lo, hi) {
    if (v < lo) {
        return lo
    }
    if (v > hi) {
        return hi
    }
    return v
}

main() {
    // Same function called with different literal arguments
    print(square(1))   // 1
    print(square(2))   // 4
    print(square(3))   // 9
    print(square(4))   // 16
    print(square(5))   // 25

    // Same function called in a loop
    i = 1
    while (i <= 5) {
        print(square(i))
        i = i + 1
    }

    // Multiple calls with variable arguments
    a = 3
    b = 7
    print(square(a))
    print(square(b))
    print(square(a + b))

    // Multiple greet calls
    greet("Alice")
    greet("Bob")
    greet("Charlie")

    // clamp called with different value/range combos
    print(clamp(-5, 0, 10))   // 0
    print(clamp(5,  0, 10))   // 5
    print(clamp(15, 0, 10))   // 10
}
