    	print("hi")
     	x = x+1
    } while(x<=2)
    
    print("Complex Boolean")
    x=0
    y=3
    print((x-y-2>3-y+x)&&(x-3<2)||(x+3<y))
    
    print("Function Calling")
    |ket> = (1,1)
    func_var = hadamard(|ket>)
    print(func_var)
    
    print("Function Calling Another Function")
    print(hadamard(get_state()))
    
    print("Recursion")
    print(factorial(3))
    
    print("Nested Loop")
    val = 0
    for(i = 0; i<3; i=i+1){
    	for(j = 0; j < 3; j = j+1){
     	    val = i*j
          	 print(val)
         }
     }
}

