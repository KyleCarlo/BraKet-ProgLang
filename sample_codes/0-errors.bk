// 0-errors.bk
// Demonstrates errors and warnings.

const |ket0> = (1, 0)
const |ket1> = (0, 1)
const PI = 3.14159

func hadamard(state) {
    H = ((0.707, 0.707), (0.707, -0.707))
    return H * state
}

func get_1(){
    return 1
}

func get_state(){
    return get_1()
}

func factorial(n){
    if(n==0 || n == 1){
        return 1
    }
    val = factorial(n - 1)
    return val * n
}
    
main() {
    print("Errors")
    dfadfafad
    print(x)
    |ket0> = (0,1)
    
    
    print("Variable Declaration")
