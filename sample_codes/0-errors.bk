    print(var_test)
    
    print("Structures")
    struct_test = {
    	x = 0,
     	y = 1
    }
    print(struct_test.y)
    
    print("Assignment")
    assign_test  = "BraKet"
    print(assign_test)
    assign_test = 1
    print(assign_test)
    
    print("Simple Math")
    math_test = 1+3*2
    print(math_test)
    
    print("Complex Math")
    |psi>  = |ket0> @ |ket1>
    <phi|  = (0.707, 0.707)
    inner  = <phi| * |psi>
    print(inner)

    print("Conditional Statements")
    x = 3
    if (x > 3) {
        x = x + 1
    } elif (x == 3) {
        x = 0
    } else {
        x = -1
    }
    print(x)

    print("Iterative Statements")
    print("--while--")
    i = 0
    while (i < 3) {
        i = i + 1
    }
